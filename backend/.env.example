ENVIRONMENT=development
DATABASE_URL=postgresql+psycopg://postgres:YOUR_URL_ENCODED_PASSWORD@YOUR_SUPABASE_HOST:5432/postgres?sslmode=require
AUTO_MIGRATE=true
# Replace YOUR_URL_ENCODED_PASSWORD with your Supabase database password; URL-encode reserved characters.
# If direct connections are unreachable on your network, copy the Session pooler URL from Supabase instead.
# Production: set AUTO_MIGRATE=false and run `alembic upgrade head` as a deployment step.
JWT_SECRET_KEY=replace-with-a-long-random-secret
FIREBASE_CREDENTIALS_PATH=C:/secure/path/firebase-service-account.json
# Creates the first Admin account on backend startup. Never commit real credentials.
ADMIN_BOOTSTRAP_EMAIL=admin@example.com
ADMIN_BOOTSTRAP_PASSWORD=replace-with-a-long-unique-password
ADMIN_BOOTSTRAP_NAME=CabSure Operations Admin
ADMIN_BOOTSTRAP_ROLE=super_admin
GEOAPIFY_API_KEY=replace_with_your_geoapify_key
MAPS_CONTACT_EMAIL=studentdishant123@gmail.com
